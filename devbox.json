{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": {
    "rustup": "latest",
    "pkg-config": "latest",
    "openssl": { "version": "latest", "outputs": ["out", "dev"] },
    "alsa-lib": { "version": "latest", "outputs": ["out", "dev"] },
    "wayland": { "version": "latest", "outputs": ["out", "dev"] },
    "libxkbcommon": { "version": "latest", "outputs": ["out", "dev"] },
    "vulkan-loader": "latest",
    "fontconfig": { "version": "latest", "outputs": ["out", "dev"] },
    "python3": "latest",
    "curl": "latest",
    "jq": "latest"
  },
  "env": {
    "RUSTUP_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/rustup",
    "CARGO_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/cargo"
  }
}
